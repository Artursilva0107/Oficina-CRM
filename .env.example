# =====================================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (adicione-o ao .gitignore).
# =====================================================================

APP_ENV=production
APP_URL=https://seu-dominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_SECRET=gere_uma_string_aleatoria_longa_aqui

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oficina_crm
DB_USERNAME=oficina_user
DB_PASSWORD=troque_esta_senha
DB_CHARSET=utf8mb4

# Telegram Bot (crie o bot com @BotFather e pegue o token)
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_WEBHOOK_SECRET=gere_uma_string_aleatoria_para_validar_o_webhook

# Transcrição de áudio (Whisper - OpenAI)
WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1

# Interpretação de linguagem natural (LLM - Claude)
NLP_PROVIDER=claude
NLP_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NLP_API_URL=https://api.anthropic.com/v1/messages
NLP_MODEL=claude-sonnet-4-6

# Painel web - sessão
SESSION_NAME=oficina_crm_sess
SESSION_LIFETIME=28800

# Identidade da oficina (usada nos PDFs de orçamento/recibo)
APP_NOME_OFICINA=Minha Oficina
